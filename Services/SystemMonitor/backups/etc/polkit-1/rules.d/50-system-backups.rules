// Allow members of backup-ops to manage backup systemd services and timers without sudo
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("backup-ops")) {
        return;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units" ||
        action.id === "org.freedesktop.systemd1.manage-unit-files") {
        var unit = action.lookup("unit") || "";
        var allowed =
            /^backup-target@[a-zA-Z0-9_-]+\.service$/.test(unit) ||
            /^backup-job@[a-zA-Z0-9_-]+_(fast|system3|sql)\.service$/.test(unit) ||
            /^ibs-backup\.service$/.test(unit) ||
            /^backup-target-[a-zA-Z0-9_-]+\.timer$/.test(unit) ||
            /^ibs-backup\.timer$/.test(unit);
        if (allowed) {
            return polkit.Result.YES;
        }
    }
});

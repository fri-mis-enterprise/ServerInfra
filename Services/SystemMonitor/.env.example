SYSTEM3_ROOT=/mnt/system3
MONITOR_DATA=./data
BASE_PATH=/systemmonitor
POLL_SECONDS=30
PORT=3030
ENABLE_WRITES=false
# Optional: seeds the initial mis account when the users table is empty.
ADMIN_PASSWORD=
SECRET_KEY=
# Only accept forwarded client IPs from this reverse proxy hostname.
TRUSTED_PROXY_HOST=caddy

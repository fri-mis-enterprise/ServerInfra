SYSTEM3_ROOT=/mnt/system3
FAST_ROOT=/mnt/fast_system
MONITOR_DATA=./data
BASE_PATH=/systemmonitor
POLL_SECONDS=30
PORT=3030
ENABLE_WRITES=false
FAST_ENABLE_WRITES=false
# Keep ro for monitoring. Manual FAST controls require rw and a writable host mount.
FAST_VOLUME_MODE=ro
# Optional: seeds the initial mis account when the users table is empty.
ADMIN_PASSWORD=
SECRET_KEY=
# Only accept forwarded client IPs from this reverse proxy hostname.
TRUSTED_PROXY_HOST=caddy

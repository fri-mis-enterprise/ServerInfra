{
  "name": "systemmonitor-interface",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun svelte-kit sync && bun --bun vite build",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./jsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
